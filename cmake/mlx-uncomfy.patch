# uncomfy patches on mlx v0.32.2 (branch fix-split-data-size of the Source/Cmlx/mlx submodule):
#  - Split reports its buffer span as data_size (fixes 32-bit indexing of large strided splits on CUDA)
#  - cuDNN convs follow MLX_CONV_ENABLE_TF32 instead of MLX_ENABLE_TF32
diff --git a/mlx/backend/common/common.cpp b/mlx/backend/common/common.cpp
index 5426301a3..8ea71cf7c 100644
--- a/mlx/backend/common/common.cpp
+++ b/mlx/backend/common/common.cpp
@@ -173,6 +173,12 @@ void Split::eval(
     size_t data_size = 1;
     size_t f_stride = 1;
     size_t b_stride = 1;
+    // Like slice, data_size is the span of buffer the output covers (last
+    // offset - first offset + 1), not its element count. Kernels read it to pick
+    // 32 vs 64-bit indexing, so a strided split of a large buffer whose element
+    // count fits in 32 bits but whose span doesn't was indexed out of range.
+    int64_t low_idx = 0;
+    int64_t high_idx = 0;
     flags.row_contiguous = true;
     flags.col_contiguous = true;
     for (int i = 0, ri = shape.size() - 1; ri >= 0; i++, ri--) {
@@ -183,7 +189,14 @@ void Split::eval(
       if (strides[i] > 0) {
         data_size *= shape[i];
       }
+      auto delta = strides[i] * (static_cast<int64_t>(shape[i]) - 1);
+      if (delta > 0) {
+        high_idx += delta;
+      } else {
+        low_idx += delta;
+      }
     }
+    size_t span = static_cast<size_t>(high_idx - low_idx + 1);
 
     if (data_size == 1) {
       // Broadcasted scalar array is contiguous.
@@ -197,7 +210,7 @@ void Split::eval(
       flags.contiguous &= flags.row_contiguous || flags.col_contiguous;
     }
 
-    return std::pair<decltype(flags), size_t>{flags, data_size};
+    return std::pair<decltype(flags), size_t>{flags, span};
   };
 
   std::vector<int> indices(1, 0);
diff --git a/mlx/backend/cuda/conv.cpp b/mlx/backend/cuda/conv.cpp
index 9e471d235..4dbc3bf38 100644
--- a/mlx/backend/cuda/conv.cpp
+++ b/mlx/backend/cuda/conv.cpp
@@ -136,7 +136,7 @@ std::optional<DnnGraph> build_conv_graph(
     return std::nullopt;
   }
   graph.deselect_numeric_notes({fe::NumericalNote_t::DOWN_CONVERT_INPUTS});
-  if (dtype == float32 && !env::enable_tf32()) {
+  if (dtype == float32 && !env::get_var("MLX_CONV_ENABLE_TF32", 1)) {
     graph.deselect_numeric_notes({fe::NumericalNote_t::TENSOR_CORE});
   }
   CHECK_CUDNN_ERROR(graph.build());
diff --git a/tests/ops_tests.cpp b/tests/ops_tests.cpp
index 09236f1da..ff414c6d6 100644
--- a/tests/ops_tests.cpp
+++ b/tests/ops_tests.cpp
@@ -527,6 +527,27 @@ TEST_CASE("test dynamic slice update") {
   CHECK(array_equal(out, expected).item<bool>());
 }
 
+TEST_CASE("test split data size") {
+  // data_size is the span of buffer an array covers; kernels use it to choose
+  // 32 vs 64-bit indexing. A strided split must report the same span as the
+  // equivalent slice, not its element count.
+  auto x = reshape(arange(24), {4, 6});
+  auto parts = split(x, 2, 1);
+  auto sl = slice(x, {0, 3}, {4, 6});
+  eval(parts);
+  eval(sl);
+  CHECK_EQ(sl.data_size(), 21); // (4 - 1) * 6 + 3
+  CHECK_EQ(parts[0].data_size(), 21);
+  CHECK_EQ(parts[1].data_size(), 21);
+  CHECK(array_equal(parts[1], sl).item<bool>());
+
+  // Contiguous splits keep their element count.
+  auto rows = split(x, 2, 0);
+  eval(rows);
+  CHECK_EQ(rows[0].data_size(), 12);
+  CHECK(rows[0].flags().row_contiguous);
+}
+
 TEST_CASE("test split") {
   array x = array(1);
   CHECK_THROWS(split(x, 0));
