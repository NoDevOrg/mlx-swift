+cublasLtMatmulHeuristicResult_t CublasMatmulBase::autotune(
+    const void* a,
+    const void* b,
+    const void* c,
+    const void* alpha_ptr,
+    const void* beta_ptr,
+    const cublasLtMatmulHeuristicResult_t* results,
+    int count) {
+  // Runs on a private stream before this op's graph capture begins. Inputs
+  // are only read (their contents don't matter for timing); the output goes
+  // to scratch memory, since the real output buffer may still be in use by
+  // work that hasn't run yet.
+  cudaStream_t stream;
+  CHECK_CUDA_ERROR(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+  size_t ws_bytes = 0;
+  for (int i = 0; i < count; ++i) {
+    ws_bytes = std::max(ws_bytes, results[i].workspaceSize);
+  }
+  void* scratch = nullptr;
+  void* ws = nullptr;
+  CHECK_CUDA_ERROR(cudaMalloc(&scratch, out_bytes_));
+  if (ws_bytes > 0) {
+    CHECK_CUDA_ERROR(cudaMalloc(&ws, ws_bytes));
+  }
+  cudaEvent_t e0, e1;
+  CHECK_CUDA_ERROR(cudaEventCreate(&e0));
+  CHECK_CUDA_ERROR(cudaEventCreate(&e1));
+  auto run = [&](const cublasLtMatmulHeuristicResult_t& r) {
+    return cublasLtMatmul(
+        handle_,
+        matmul_desc_,
+        alpha_ptr,
+        b,
+        a_desc_,
+        a,
+        b_desc_,
+        beta_ptr,
+        c ? c : scratch,
+        c ? c_desc_ : out_desc_,
+        scratch,
+        out_desc_,
+        &r.algo,
+        ws,
+        r.workspaceSize,
+        stream);
+  };
+  std::vector<float> times(count, 0);
+  for (int i = 0; i < count; ++i) {
+    if (results[i].state != CUBLAS_STATUS_SUCCESS ||
+        run(results[i]) != CUBLAS_STATUS_SUCCESS) {
+      continue;
+    }
+    cudaEventRecord(e0, stream);
+    for (int r = 0; r < 3; ++r) {
+      run(results[i]);
+    }
+    cudaEventRecord(e1, stream);
+    cudaEventSynchronize(e1);
+    float ms = 0;
+    cudaEventElapsedTime(&ms, e0, e1);
+    times[i] = ms;
+  }
+  cudaStreamSynchronize(stream);
+  cudaEventDestroy(e0);
+  cudaEventDestroy(e1);
+  cudaFree(scratch);
+  if (ws) {
+    cudaFree(ws);
+  }
+  cudaStreamDestroy(stream);
+  // The first candidate, in cuBLASLt's own order, that is at least 1.5x
+  // faster than the default; else the default. Not simply the fastest: when
+  // two candidates are both fast and close, timing noise picked a different
+  // one from run to run, which changed the rounding and the render.
+  for (int i = 1; i < count; ++i) {
+    if (times[0] > 0 && times[i] > 0 && times[i] * 1.5f < times[0]) {
+      return results[i];
+    }
+  }
+  return results[0];
+}
