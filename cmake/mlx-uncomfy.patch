+  }
+  return done;
+}
+
+// Whether direct reads of this filesystem are possible and worth it, measured
+// once per filesystem. The sample is spaced through the file. The first round
+// warms the pool and staging, then either of two timed rounds can pass, so a
+// moment of contention doesn't decide for the life of the process.
+bool direct_worthwhile(
+    int fd,
+    dev_t device,
+    size_t file_size,
+    const std::string& label) {
+  static std::mutex mutex;
+  static auto& verdicts = *new std::unordered_map<dev_t, bool>();
+  std::lock_guard<std::mutex> lock(mutex);
+  if (auto it = verdicts.find(device); it != verdicts.end()) {
+    return it->second;
+  }
+  constexpr int rounds = 3;
+  size_t spacing = file_size / (chunk_threads * rounds);
+  double best = 0;
+  bool works = true;
+  for (int round = 0; round < rounds && works; round++) {
+    auto start = std::chrono::steady_clock::now();
+    std::vector<std::future<bool>> reads;
+    for (size_t i = 0; i < chunk_threads; i++) {
+      size_t at = ((i * rounds + round) * spacing) & ~(direct_align - 1);
+      reads.emplace_back(chunk_pool().enqueue([fd, at]() {
+        char* stage = staging();
+        return stage != nullptr &&
+            pread(fd, stage, chunk_size, at) ==
+            static_cast<ssize_t>(chunk_size);
+      }));
+    }
+    for (auto& r : reads) {
+      works = r.get() && works;
+    }
+    std::chrono::duration<double> took =
+        std::chrono::steady_clock::now() - start;
+    if (round > 0) {
+      best = std::max(best, chunk_threads * chunk_size / 1e9 / took.count());
+      if (best >= min_direct_gb_per_s) {
+        break;
+      }
+    }
+  }
+  bool verdict = works && best >= min_direct_gb_per_s;
+  std::cerr << "[mlx] direct read test on " << label << ": ";
+  if (works) {
+    std::cerr << best << " GB/s, ";
+  } else {
+    std::cerr << "reads failed, ";
+  }
+  std::cerr << (verdict ? "using direct reads" : "using buffered reads")
+            << std::endl;
+  verdicts[device] = verdict;
+  return verdict;
+}
+
+} // namespace
+
+void ParallelFileReader::setup_direct() {
+  if (read_mode() == ReadMode::buffered) {
+    return;
+  }
+  bool forced = read_mode() == ReadMode::direct;
+  struct stat st;
+  if (fstat(fd_, &st) != 0 ||
+      (!forced && static_cast<size_t>(st.st_size) < min_direct_file)) {
+    return;
+  }
+  // Through /proc so it's fd_'s inode, even if a download has since replaced
+  // the file by rename. Two paths to two files would read wrong bytes silently.
+  std::string self = "/proc/self/fd/" + std::to_string(fd_);
+  direct_fd_ = open(self.c_str(), O_RDONLY | O_DIRECT | O_CLOEXEC);
+  if (direct_fd_ < 0) {
+    std::cerr << "[mlx] " << label() << " can't open for direct reads ("
+              << std::strerror(errno) << "), using buffered reads" << std::endl;
+    return;
+  }
+  direct_on_ = forced ||
+      direct_worthwhile(direct_fd_, st.st_dev, st.st_size, label());
+}
+
+// The page cache first, so cached bytes stay cheap, then direct for the misses,
+// then buffered for whatever direct couldn't do. Only a buffered failure counts.
+bool ParallelFileReader::read_chunk(char* data, size_t n, size_t offset) {
+  if (direct_on_) {
+    if (nowait_on_) {
+      iovec v{data, n};
+      auto m = preadv2(fd_, &v, 1, offset, RWF_NOWAIT);
+      if (m > 0) {
+        data += m;
+        n -= m;
+        offset += m;
+      } else if (m < 0 && errno != EAGAIN) {
+        nowait_on_ = false;
+      }
+    }
+    if (n != 0) {
+      size_t m = read_direct(direct_fd_, data, n, offset);
+      data += m;
+      n -= m;
+      offset += m;
+      if (n != 0 && direct_on_.exchange(false)) {
+        std::cerr << "[mlx] direct read of " << label() << " stopped at "
+                  << offset << ", using buffered reads" << std::endl;
+      }
+    }
+  }
+  while (n != 0) {
+    auto m = pread(fd_, data, n, offset);
+    if (m <= 0) {
+      return false;
+    }
+    data += m;
+    n -= m;
+    offset += m;
+  }
+  return true;
+}
+
+void ParallelFileReader::read_chunked(char* data, size_t n, size_t offset) {
+  std::call_once(direct_once_, [this] { setup_direct(); });
+  std::vector<std::future<bool>> futs;
+  while (n >= chunk_size) {
+    futs.emplace_back(chunk_pool().enqueue(
+        [this, data, offset] { return read_chunk(data, chunk_size, offset); }));
+    data += chunk_size;
+    n -= chunk_size;
+    offset += chunk_size;
+  }
+  bool ok = n == 0 || read_chunk(data, n, offset);
+  for (auto& f : futs) {
+    ok = f.get() && ok;
+  }
+  if (!ok) {
+    throw std::runtime_error("[read] Unable to read from file.");
+  }
+}
